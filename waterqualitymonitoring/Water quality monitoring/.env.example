# Data source: "mock" (default) or "arcgis"
VITE_DATA_PROVIDER=mock

# ArcGIS Enterprise Portal (OAuth)
VITE_ARCGIS_PORTAL_URL=https://gh.space.gov.rw/portal

# Registered ArcGIS Application Client ID (never commit a real production secret;
# Client IDs are public identifiers, but still keep environment-specific values out of source)
VITE_ARCGIS_CLIENT_ID=

# ArcGIS Enterprise FeatureServer base URL (no token query params)
VITE_ARCGIS_FEATURE_SERVICE_URL=https://gh.space.gov.rw/server/rest/services/Hosted/RW_WaterQuality_Monitor_View/FeatureServer

# Optional: production Web Map item id (defaults to RW Water Quality Monitor - Map)
# VITE_ARCGIS_WEBMAP_ID=f72eafbf58e8474c89afc49f9eb5ebd8
