# Default production build = GeoHub IIS (/forest-mapping/).
# On Vercel, vercel.json env overrides these to VITE_BASE_PATH=/ and VITE_API_BASE=/api.
VITE_BASE_PATH=/forest-mapping/
VITE_API_BASE=/forest-mapping/api
VITE_USE_MOCK_DATA=false
VITE_WEBMAP_ITEM_ID=25ba26abf42b48a29aaec4cecbafad74
VITE_PORTAL_URL=https://gh.space.gov.rw/portal
VITE_ARCGIS_CLIENT_ID=U2YKEbSfWRrjG16y
# Leave unset so localhost / Vercel / GeoHub pick redirect from origin automatically.
# Register each host on the GeoHub OAuth app:
#   http://localhost:5173/forest-mapping/oauth/callback
#   https://gh.space.gov.rw/forest-mapping/oauth/callback
#   https://YOUR_PROJECT.vercel.app/oauth/callback
