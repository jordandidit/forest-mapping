# ── Server (Vercel Project → Environment Variables, or local .env) ──────────
ARCGIS_PORTAL_URL=https://gh.space.gov.rw/portal
FOREST_HEALTH_SERVICE_URL=https://gh.space.gov.rw/server/rest/services/Hosted/RW_ForestHealth_V2_View/FeatureServer
WEBMAP_ITEM_ID=25ba26abf42b48a29aaec4cecbafad74
SESSION_SECRET=change-me-to-a-long-random-secret
AUTH_REQUIRED=true
APP_REFERER=https://your-app.vercel.app/
PORT=8787

# ── Client (baked in at build time — set on Vercel for Production + Preview) ─
VITE_ARCGIS_CLIENT_ID=U2YKEbSfWRrjG16y
VITE_USE_MOCK_DATA=false
VITE_WEBMAP_ITEM_ID=25ba26abf42b48a29aaec4cecbafad74
VITE_PORTAL_URL=https://gh.space.gov.rw/portal

# Vercel (vercel.json sets these; override in dashboard if needed):
#   VITE_BASE_PATH=/
#   VITE_API_BASE=/api
#   VITE_USE_GIS_PROXY=true
#
# GeoHub IIS build (npm run build without VERCEL):
#   VITE_BASE_PATH=/forest-mapping/
#   VITE_API_BASE=/forest-mapping/api

VITE_API_BASE=/api

# GeoHub OAuth app — register every host you deploy to, e.g.:
#   http://localhost:5173/forest-mapping/oauth/callback
#   https://gh.space.gov.rw/forest-mapping/oauth/callback
#   https://YOUR_PROJECT.vercel.app/oauth/callback
# Optional override:
# VITE_OAUTH_REDIRECT_URI=https://YOUR_PROJECT.vercel.app/oauth/callback
